# RescueLens XR - Environment Configuration Template
# Copy this file to .env and fill in the values

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG_MODE=True

# Firebase Configuration
FIREBASE_DATABASE_URL=https://rescuelens-xr-default-rtdb.firebaseio.com/
FIREBASE_CREDENTIALS_PATH=./firebase/serviceAccountKey.json

# Simulation Mode (Set to True when testing without physical ESP32)
SIMULATION_MODE=True

# Alert Thresholds
SMOKE_THRESHOLD_PPM=300
TEMP_THRESHOLD_CELSIUS=45.0
FLAME_DETECTED_VALUE=0
